{
  "manifest_version": 3,
  "name": "Download Valet",
  "version": "1.0.1",
  "description": "Sorts downloads into folders by file type: images, documents, videos, archives and more. Every rule is editable.",
  "permissions": [
    "downloads",
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/sorter.svg",
    "32": "icons/sorter.svg",
    "48": "icons/sorter.svg",
    "96": "icons/sorter.svg",
    "128": "icons/sorter.svg"
  },
  "action": {
    "default_title": "Download Valet",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/sorter.svg",
      "32": "icons/sorter.svg",
      "48": "icons/sorter.svg"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "shared/rules.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "download-sorter@tiagovla",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
